{
  // This sample uses a GCG image whose UID/GID 1000 account is named ubuntu.
  // A different compatible image may use another name. If you change the
  // image, change both user fields to that image's UID/GID 1000 account.
  //
  // Do not replace this file with one generated by VS Code. Generated files
  // can add Docker Compose, custom mounts or host access that GCG does not
  // support. The platform already supplies /workspaces, /shared and the GPU.
  "build": {
    // Dockerfile is next to this file. The context is the repository root.
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // The names must match the selected image. The account must have numeric
  // UID 1000 and primary GID 1000, and its HOME must exist and be writable.
  "containerUser": "ubuntu",
  "remoteUser": "ubuntu",

  // Paths only, never secrets. Container-level values reach every process,
  // including Claude Code sessions, which do not read ~/.bashrc.
  "containerEnv": {
    // Per-workspace, on the persistent /workspaces disk (HOME is reset on
    // every stop/start): Claude Code login and history, misc and compile caches.
    "CLAUDE_CONFIG_DIR": "/workspaces/.claude",
    "XDG_CACHE_HOME": "/workspaces/.cache",
    "TRITON_CACHE_DIR": "/workspaces/.cache/triton",
    "TORCHINDUCTOR_CACHE_DIR": "/workspaces/.cache/torchinductor",
    // Shared by every host. Keep in sync with
    // /home/ubuntu/shared/env/common.sh and gcg-standard's
    // ~/.claude/settings.json "env".
    "HF_HOME": "/home/ubuntu/shared/cache/huggingface",
    "UV_CACHE_DIR": "/home/ubuntu/shared/cache/uv",
    "TORCH_HOME": "/home/ubuntu/shared/cache/torch"
  },

  // Repeat-safe: targets of the ~/.ssh and ~/.claude links from Dockerfile.
  "postCreateCommand": "mkdir -p -m 700 /workspaces/.ssh /workspaces/.claude"

  // STOP HERE. Do not add workspaceFolder, workspaceMount, mounts, runArgs,
  // privileged, capAdd, securityOpt, dockerComposeFile or hostRequirements.
  // Do not add a Docker socket or NVIDIA device mount.
}
